# Copier en .env puis remplacer les valeurs "change-me". Ne jamais committer .env.
# Utiliser des mots de passe sans caractères spéciaux d'URL (@ : / ? # %) :
# ils sont insérés tels quels dans DATABASE_URL.

POSTGRES_USER=supervisor
POSTGRES_PASSWORD=change-me
POSTGRES_DB=supervisor

# DATABASE_URL et REDIS_URL sont construites par docker-compose.yml.
# Hors Docker (développement local), les définir explicitement :
# DATABASE_URL=postgresql+asyncpg://supervisor:change-me@localhost:5432/supervisor
# REDIS_URL=redis://localhost:6379/0

# Secret de signature des JWT (obligatoire, 32 caractères minimum) : openssl rand -hex 32
JWT_SECRET=

# Cookies de session en Secure (HTTPS). Mettre false uniquement pour un essai en HTTP local.
COOKIE_SECURE=true

# Nginx (HTTPS). Certificat : deploy/gen-cert.sh <nom-de-serveur> (auto-signé) ou vos fichiers
# fullchain.pem et privkey.pem dans TLS_CERT_DIR.
TLS_CERT_DIR=./deploy/certs
HTTP_PORT=80
HTTPS_PORT=443
# Port HTTPS non standard : HTTPS_PORT=8443 et HTTPS_PORT_SUFFIX=:8443 (utilisé par la redirection).
HTTPS_PORT_SUFFIX=

# Verrouillage d'un compte : LOGIN_MAX_FAILURES échecs de connexion le bloquent LOGIN_LOCK_S secondes.
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_S=900

LOG_LEVEL=INFO
RETENTION_DAYS=730

# Notifications d'alarmes par email (laisser SMTP_HOST vide pour les désactiver ; les webhooks
# et l'interface fonctionnent sans). Le port 465 utilise TLS direct, sinon STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
ALARM_EMAIL_FROM=supervision@example.org
# Destinataires du canal `email` sans adresse précise, séparés par des virgules.
ALARM_EMAIL_TO=
# Au-delà de N notifications par fenêtre (secondes), les suivantes sont regroupées en un message.
ALARM_DIGEST_THRESHOLD=20
ALARM_DIGEST_WINDOW_S=60

# Interface du collecteur BACnet avec masque, ex. 192.168.1.10/24 (sinon : config/collector.yaml)
BACNET_BIND_IP=

# Fichier de configuration du collecteur (défaut : /config/collector.yaml).
# Avec le simulateur (`docker compose --profile sim up -d --build`) :
# COLLECTOR_CONFIG=/config/collector.sim.yaml
