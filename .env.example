# Copier en .env puis remplacer les valeurs "change-me". Ne jamais committer .env.
# Utiliser des mots de passe sans caractères spéciaux d'URL (@ : / ? # %) :
# ils sont insérés tels quels dans DATABASE_URL.

POSTGRES_USER=supervisor
POSTGRES_PASSWORD=change-me
POSTGRES_DB=supervisor

# DATABASE_URL et REDIS_URL sont construites par docker-compose.yml.
# Hors Docker (développement local), les définir explicitement :
# DATABASE_URL=postgresql+asyncpg://supervisor:change-me@localhost:5432/supervisor
# REDIS_URL=redis://localhost:6379/0

# Secret de signature des JWT (Jalon 3) : openssl rand -hex 32
JWT_SECRET=

LOG_LEVEL=INFO
RETENTION_DAYS=730

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Interface du collecteur BACnet avec masque, ex. 192.168.1.10/24 (sinon : config/collector.yaml)
BACNET_BIND_IP=

# Fichier de configuration du collecteur (défaut : /config/collector.yaml).
# Avec le simulateur (`docker compose --profile sim up -d --build`) :
# COLLECTOR_CONFIG=/config/collector.sim.yaml
