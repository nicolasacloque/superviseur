# Rendu par l'image nginx : seules les variables d'environnement définies sont substituées
# (${HTTPS_PORT_SUFFIX}) ; les variables Nginx ($host, $remote_addr...) restent intactes.

server_tokens off;

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# Freine la force brute sur la connexion, en plus du verrouillage de compte de l'API.
limit_req_zone $binary_remote_addr zone=login:10m rate=60r/m;

server {
    listen 80 default_server;
    server_name _;
    # Sonde du healthcheck Docker (sans TLS : elle ne dépend que du bon démarrage de Nginx).
    location = /nginx-health {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }
    # Tout passe en HTTPS ; seul le port 80 sert à rediriger.
    location / {
        return 301 https://$host${HTTPS_PORT_SUFFIX}$request_uri;
    }
}

server {
    listen 443 ssl default_server;
    http2 on;
    server_name _;

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1h;
    ssl_session_tickets off;

    include /etc/nginx/snippets/security-headers.conf;

    client_max_body_size 8m;       # un synoptique avec images peut atteindre 6 Mo
    root /usr/share/nginx/html;
    index index.html;

    # L'adresse de l'api est résolue à chaque requête : nginx démarre même si l'api est arrêtée,
    # et retrouve le service après son redémarrage (nouvelle adresse IP possible).
    resolver 127.0.0.11 valid=10s ipv6=off;

    location = /health {
        set $api http://api:8000;
        proxy_pass $api;
        proxy_set_header Host $host;
    }

    # Connexion : limitée en débit.
    location = /api/v1/auth/login {
        limit_req zone=login burst=30 nodelay;
        limit_req_status 429;
        set $api http://api:8000;
        proxy_pass $api;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Temps réel : connexion longue.
    location = /api/v1/ws {
        set $api http://api:8000;
        proxy_pass $api;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location /api/ {
        set $api http://api:8000;
        proxy_pass $api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # $remote_addr et non $proxy_add_x_forwarded_for : un client ne peut pas usurper son adresse.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    # Fichiers versionnés par leur empreinte : cache long. `expires` (et non add_header) pour
    # conserver les en-têtes de sécurité du serveur.
    location /assets/ {
        expires 1y;
        try_files $uri =404;
    }

    location = /index.html {
        expires -1;
    }

    location / {
        try_files $uri $uri/ =404;
    }

    location ~ /\. {
        deny all;
    }
}
